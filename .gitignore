node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular build output
dist/
tmp/
out-tsc/
bazel-out/

# Angular cache
.angular/

# IDEs and editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
